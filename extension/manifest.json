{
  "manifest_version": 3,
  "name": "Flat Finder Importer",
  "version": "1.0.0",
  "description": "Собирает объявление о квартире со страницы (Avito, Cian, DomClick, Яндекс Недвижимость) и отправляет во Flat Finder на проверку.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Flat Finder — открыть настройки",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options.html",
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.avito.ru/*",
        "https://*.cian.ru/*",
        "https://*.domclick.ru/*",
        "https://*.domclick.com/*",
        "https://realty.yandex.ru/*",
        "https://*.realty.yandex.ru/*",
        "https://realty.ya.ru/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"]
}
