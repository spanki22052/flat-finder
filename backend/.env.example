# --- Server ---
PORT=3001
NODE_ENV=development

# --- Database (Postgres via Docker locally) ---
DATABASE_URL="postgresql://flatfinder:flatfinder@localhost:5432/flatfinder?schema=public"

# --- Auth ---
JWT_SECRET="change-me-in-prod-please-use-a-long-random-string"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=10

# --- Parser ---
# RU residential proxy is strongly recommended for DomClick/Qrator.
# PARSER_PROXY_URL=http://user:pass@proxy-host:port
# PARSER_HEADLESS=true
# Use installed Google Chrome for DomClick TLS/browser fingerprint.
# Set false only when Chrome is unavailable on the host.
# PARSER_DOMCLICK_USE_CHROME=true
# REBROWSER_PATCHES_RUNTIME_FIX_MODE=alwaysIsolated
# REBROWSER_PATCHES_UTILITY_WORLD_NAME=__ex