// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth / Users ────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  username  String   @unique
  password  String
  name      String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apartments      Apartment[]  @relation("AssignedApartments")
  reminders       Reminder[]   @relation("AssignedReminders")
  roomMemberships RoomMember[]
}

enum UserRole {
  USER
  ADMIN
}

// ─── Rooms ────────────────────────────────────────────────────────────────────

model Room {
  id         String   @id @default(uuid())
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members    RoomMember[]
  apartments Apartment[]
  contacts   Contact[]
  reminders  Reminder[]
  tags       ApartmentTag[]
}

enum RoomRole {
  OWNER
  MEMBER
}

model RoomMember {
  id       String   @id @default(uuid())
  roomId   String
  userId   String
  role     RoomRole @default(MEMBER)
  joinedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@index([userId])
}

// ─── Apartments ───────────────────────────────────────────────────────────────

model Apartment {
  id                     String          @id @default(uuid())
  roomId                 String
  title                  String
  source                 ApartmentSource @default(MANUAL)
  sourceUrl              String?
  price                  Float
  deposit                Float?
  agentCommissionPercent Float?
  currency               Currency        @default(EUR)
  city                   String
  district               String?
  address                String?
  rooms                  Int?
  area                   Float?
  floor                  Int?
  totalFloors            Int?
  description            String?
  photos                 String[]        @default([])
  phones                 String[]        @default([])
  status                 ApartmentStatus @default(NEW)
  contactId              String?
  assigneeId             String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  room      Room       @relation(fields: [roomId], references: [id])
  contact   Contact?   @relation(fields: [contactId], references: [id])
  assignee  User?      @relation("AssignedApartments", fields: [assigneeId], references: [id])
  reminders Reminder[]

  tags ApartmentTag[]

  @@index([roomId])
  @@index([status])
  @@index([city])
  @@index([assigneeId])
}

enum ApartmentSource {
  MANUAL
  LINK
}

enum ApartmentStatus {
  NEW
  ACTIVE
  CALLBACK
  VIEWING
  REJECTED
  DONE
}

enum Currency {
  EUR
  USD
  RUB
  PLN
}

model ApartmentTag {
  id         String      @id @default(uuid())
  roomId     String
  name       String
  apartments Apartment[]

  room Room @relation(fields: [roomId], references: [id])

  @@unique([roomId, name])
  @@index([roomId])
}

// ─── Contacts ────────────────────────────────────────────────────────────────

model Contact {
  id        String   @id @default(uuid())
  roomId    String
  name      String
  phone     String?
  telegram  String?
  whatsapp  String?
  email     String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room       Room        @relation(fields: [roomId], references: [id])
  apartments Apartment[]

  @@index([roomId])
}

// ─── Reminders ───────────────────────────────────────────────────────────────

model Reminder {
  id          String         @id @default(uuid())
  roomId      String
  apartmentId String?
  title       String
  dueAt       DateTime
  status      ReminderStatus @default(PENDING)
  assigneeId  String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  room      Room       @relation(fields: [roomId], references: [id])
  apartment Apartment? @relation(fields: [apartmentId], references: [id])
  assignee  User       @relation("AssignedReminders", fields: [assigneeId], references: [id])

  @@index([roomId])
  @@index([status])
  @@index([assigneeId])
}

enum ReminderStatus {
  PENDING
  DONE
  CANCELED
}
