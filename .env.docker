# Docker Compose environment variables
# Copy this file to .env and adjust values as needed

# --- Auth ---
JWT_SECRET=change-me-in-prod-please-use-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# --- Parser (optional) ---
# RU residential proxy is strongly recommended for DomClick/Qrator
# PARSER_PROXY_URL=http://user:pass@proxy-host:port
# PARSER_HEADLESS=true
# PARSER_DOMCLICK_USE_CHROME=true
